# Configuracao da API NefroSmart (Exemplo Seguro para Desenvolvimento/Portfólio)
# O sistema funciona com dados ficticios de demonstracao se a conexao Oracle nao estiver preenchida.

REMOTE_API_URL=
DB_USER=seu_usuario_oracle
DB_PASSWORD=sua_senha_oracle
DB_DSN=localhost:1521/XEPDB1
ORACLE_CLIENT_DIR=C:\oracle\instantclient_23_8
AUTH_SERVICE_URL=http://localhost:8001/api/auth/login
TOTP_SECRET=SEU_TOTP_SECRET_SEGURO_AQUI
MV_LOGIN_URL=http://localhost:5000/api/login
